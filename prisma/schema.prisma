// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Auth.js (standard Prisma adapter models) ────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Product-specific fields
  authProvider      String? // google | email | github
  githubAccessToken String? // encrypted at rest
  githubUsername    String?

  // Stripe billing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 Plan      @default(free)
  planStatus           PlanStatus @default(none)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts    Account[]
  sessions    Session[]
  projects    Project[]
  usageEvents UsageEvent[]
}

enum Plan {
  free
  premium
}

enum PlanStatus {
  none
  active
  past_due
  canceled
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String // analysis
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Product domain ──────────────────────────────────────────────────────────

enum ProjectSource {
  github
  upload
}

enum ProjectStatus {
  queued
  processing
  completed
  failed
}

model Project {
  id              String        @id @default(cuid())
  userId          String
  name            String
  source          ProjectSource
  repositoryUrl   String?
  framework       String?
  status          ProjectStatus @default(queued)
  errorMessage    String?
  fileCount       Int           @default(0)
  progressStep    String?
  progressPercent Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks  CodeChunk[]
  report  Report?

  @@index([userId])
}

model CodeChunk {
  id        String                       @id @default(cuid())
  projectId String
  filePath  String
  content   String                       @db.Text
  startLine Int?
  endLine   Int?
  // Local MiniLM (Xenova/all-MiniLM-L6-v2) → 384 dimensions
  embedding Unsupported("vector(384)")?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Report {
  id             String   @id @default(cuid())
  projectId      String   @unique
  healthScore    Int
  categoryScores Json // { architecture, security, performance, codeQuality, testing }
  issues         Json // [{ title, description, severity, category, filePath }]
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
