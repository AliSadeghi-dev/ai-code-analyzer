# Database (Postgres + pgvector — e.g. Neon or Supabase)
# Prefer Supabase Session pooler URI + ?sslmode=require
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Groq (chat, health report, file explain) — https://console.groq.com/keys
GROQ_API_KEY=
# Optional: chat/explain model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional: structured JSON report model — must support json_schema
# (default: openai/gpt-oss-120b). See console.groq.com/docs/structured-outputs
# GROQ_STRUCTURED_MODEL=openai/gpt-oss-120b

# Embeddings run locally via @xenova/transformers (no API key / quota)

# Stripe billing — https://dashboard.stripe.com
# Use test keys while developing (sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Price ID for Premium (price_…)
STRIPE_PRICE_PREMIUM=
# From `stripe listen --forward-to localhost:3000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=

# Optional plan display / limit overrides (Settings Billing reads these)
# Price label is loaded from Stripe automatically via STRIPE_PRICE_PREMIUM.
# Set this only if you want to override the Stripe-displayed price:
# NEXT_PUBLIC_PLAN_PREMIUM_PRICE_LABEL=$99/mo
# NEXT_PUBLIC_PLAN_PREMIUM_LABEL=Premium
# NEXT_PUBLIC_PLAN_FREE_LABEL=Free
# PLAN_FREE_ANALYSES_PER_DAY=5
# PLAN_FREE_CHAT_PER_HOUR=20
# PLAN_FREE_MAX_PROJECTS=5
# PLAN_PREMIUM_ANALYSES_PER_DAY=50
# PLAN_PREMIUM_CHAT_PER_HOUR=200
